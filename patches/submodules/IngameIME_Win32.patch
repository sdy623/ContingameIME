 namespace IngameIME::tf
 {
+static bool get_compartment_bool(ITfCompartment* comp)
+{
+    if (!comp) return false;
+    VARIANT var;
+    VariantInit(&var);
+    if (FAILED(comp->GetValue(&var))) return false;
+    // Most TSF compartments use VT_I4.
+    if (var.vt == VT_I4) return var.lVal != 0;
+    if (var.vt == VT_INT) return var.intVal != 0;
+    return false;
+}
+
+static int get_compartment_int(ITfCompartment* comp)
+{
+    if (!comp) return 0;
+    VARIANT var;
+    VariantInit(&var);
+    if (FAILED(comp->GetValue(&var))) return 0;
+    if (var.vt == VT_I4) return (int)var.lVal;
+    if (var.vt == VT_INT) return (int)var.intVal;
+    return 0;
+}
+
