{
  "schemaVersion": 1,
  "id": "ingameime",
  "version": "${version}",
  "name": "ContingameIME-Neo",
  "description": "An unofficial continuation of an unofficial continuation of IngameIME.\nEnable IME in FullScreen Minecraft",
  "authors": [
    "ThinkingStudio, TexTrue, Wybxc", "Windmill_City", "Wudji", "sdy623"
  ],
  "contributors": [
    "Hendrix-Shen"
  ],
  "contact": {
    "sources": "https://github.com/sdy623/XPlus-ContingameIME",
    "issues": "https://github.com/sdy623/XPlus-ContingameIME/issues"
  },
  "license": "LGPL-3.0",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "city.sdy623.kitsuneime.fabric.KitsuneIMEClientFabric"
      }
    ]
  },
  "mixins": [
    {
      "config": "kitsuneime.fabric.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "minecraft": "1.20.6",
    "fabricloader": "*",
    "fabric-key-binding-api-v1": "*",
    "fabric-language-kotlin": "*",
    "architectury": "*",
    "cloth-config": "*"
  },
  "recommends": {
    "satin": "*"
  }
}
